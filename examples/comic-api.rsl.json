{
  "rsl": "2.0",
  "id": "comic.example.com",
  "name": "示例漫画站（JSON 接口 + 多载体）",
  "type": "comic",
  "baseUrl": "https://comic.example.com",
  "match": { "detail": "re:^https://comic\\.example\\.com/book/\\w+" },
  "lang": "zh",
  "version": "2.0.0",
  "requires": {
    "engine": ">=2.0 <3.0",
    "features": ["js", "time", "crypto"],
    "crypto": ["md5"],
    "selectorLevel": { "jsonpath": "9535", "css": "3" }
  },
  "http": {
    "headers": { "Accept": "application/json", "Referer": "var:baseUrl" },
    "timeout": 12000,
    "retry": { "times": 2, "backoff": "linear", "on": [429, 500, 502, 503] },
    "rate": { "rps": 3, "burst": 6 },
    "cookies": "persistent"
  },
  "vars": {
    "appKey": { "value": "demo-app-key", "label": "AppKey", "persist": true, "secret": true },
    "line": {
      "value": "https://api1.comic.example.com",
      "label": "接口线路",
      "options": ["https://api1.comic.example.com", "https://api2.comic.example.com"],
      "persist": true
    }
  },
  "media": {
    "headers": { "Referer": "var:baseUrl" },
    "decode": { "in": "bytes", "out": "bytes", "fn": "lib:decryptImage" },
    "cache": { "ttl": 604800 },
    "maxBytes": 31457280
  },
  "cache": {
    "token": {
      "request": { "url": "var:line/api/token", "params": { "key": "var:appKey" } },
      "take": "json:$.data.token",
      "ttl": 3600
    }
  },
  "merge": {
    "key": ["name", "author"],
    "normalize": ["trim", "t2s"],
    "crossBucket": true,
    "order": ["exact", "contains", "sources", "weight"],
    "weight": 1.0
  },
  "lib": {
    "pure": "function sign(ts, key, q){ return '' + ts + ':' + key + ':' + q; }\nfunction toImages(arr){ var out=[]; for(var i=0;i<arr.length;i++){ out.push({url: arr[i], headers: {Referer: 'https://comic.example.com/'}}); } return out; }\nfunction decryptImage(bytes){ for (var i=0;i<bytes.length;i++) bytes[i] = bytes[i] ^ 0x5A; return bytes; }",
    "ctx": ""
  },
  "stages": {
    "search": {
      "let": {
        "ts": "expr:now()",
        "sign": "expr:md5(var:kw + str(let:ts) + var:appKey)"
      },
      "request": {
        "url": "var:line/api/search",
        "method": "POST",
        "body": {
          "type": "json",
          "data": { "q": "var:kw", "offset": "expr:(page - 1) * 20", "ts": "let:ts", "sign": "let:sign" }
        },
        "response": "json"
      },
      "out": {
        "list": "json:$.data.items[*]",
        "map": {
          "name": { "$": "json:$.title", "transform": [{ "trim": true }] },
          "url": { "$": "expr:'https://comic.example.com/book/' + var:item.id" },
          "cover": { "$": "json:$.cover", "optional": true },
          "author": { "$": "json:$.author", "optional": true },
          "type": {
            "$": "json:$.kind",
            "typeMap": { "comic": "comic", "novel": "novel", "audio": "audio" }
          }
        },
        "emptyOk": true
      },
      "paginate": {
        "kind": "cursor",
        "cursor": { "take": "json:$.data.next_offset", "into": "body.data.offset" },
        "carry": ["search_id", "passback"],
        "max": 20,
        "stopIf": { "empty": "out.list" }
      }
    },

    "detail": {
      "request": { "url": "var:book.url", "response": "json" },
      "out": {
        "name": { "$": "json:$.data.title", "transform": [{ "trim": true }] },
        "author": { "$": "json:$.data.author", "optional": true },
        "intro": { "$": "json:$.data.desc", "optional": true },
        "cover": { "$": "json:$.data.cover", "optional": true },
        "kind": { "$": "json:$.data.tags[*]", "transform": [{ "join": "," }], "optional": true },
        "type": { "$": "json:$.data.kind", "typeMap": { "comic": "comic", "novel": "novel" } },
        "lastChapter": { "$": "json:$.data.last", "optional": true },
        "tocUrl": { "$": "expr:'https://comic.example.com/api/toc?book=' + var:book.id", "optional": true }
      }
    },

    "toc": {
      "request": { "url": "var:book.tocUrl", "response": "json" },
      "order": "desc",
      "dedupe": "url",
      "out": {
        "list": "json:$.data.chapters[*]",
        "map": {
          "title": { "$": "json:$.name", "transform": [{ "trim": true }] },
          "url": { "$": "expr:'https://comic.example.com/chapter/' + var:item.id" },
          "isVip": { "$": "json:$.vip", "transform": [{ "number": true }] },
          "updateTime": { "$": "json:$.updated_at", "optional": true }
        },
        "emptyOk": true
      },
      "paginate": { "kind": "cursor", "cursor": { "take": "json:$.data.next", "into": "params.page_token" }, "max": 100 }
    },

    "content": {
      "request": { "url": "var:chapter.url", "response": "json" },
      "out": {
        "title": { "$": "json:$.data.title", "optional": true },
        "images": {
          "$": "json:$.data.images[*]",
          "transform": [{ "js": "lib:toImages" }]
        },
        "tracks": []
      }
    }
  },
  "limits": {
    "maxBytes": { "value": 4194304, "on": "reject" },
    "maxNodes": { "value": 5000, "on": "truncate" },
    "timeoutMs": 15000,
    "maxPages": { "value": 100, "on": "truncate" },
    "maxParallel": 4,
    "libSteps": 1000000,
    "scriptTimeoutMs": 3000,
    "mediaBytes": 31457280
  },
  "meta": {
    "author": "rsl-spec",
    "license": "CC0",
    "updated": "2026-11-21",
    "comment": "虚构站点，演示：let 签名、条目级载体覆盖、逐图请求头、bytes 级解密、cursor 分页、多源合并契约",
    "changelog": [{ "version": "2.0.0", "date": "2026-11-21", "note": "按 RSL 2.0 重写" }]
  }
}
