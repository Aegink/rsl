{
  "name": "rsl-vscode",
  "displayName": "RSL Reader Source Language",
  "description": "RSL 书源语言支持：诊断 / hover / 补全 / 定义 / 快速修复（由 rsl-lsp 提供）",
  "version": "2.0.0",
  "publisher": "rsl-spec",
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "rsl",
    "book source",
    "reader",
    "json"
  ],
  "activationEvents": [
    "onLanguage:rsl",
    "onLanguage:json",
    "onCommand:rsl.formEditor",
    "onCommand:rsl.debug",
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "rsl",
        "aliases": [
          "RSL Source",
          "rsl"
        ],
        "extensions": [
          ".rsl.json"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": "*.rsl.json",
        "url": "./schema/rsl.schema.json"
      }
    ],
    "snippets": [
      {
        "language": "json",
        "path": "./snippets/rsl.json"
      }
    ],
    "commands": [
      {
        "command": "rsl.formEditor",
        "title": "RSL: 打开表单编辑器",
        "category": "RSL",
        "icon": "$(json)"
      },
      {
        "command": "rsl.debug",
        "title": "RSL: 调试源（serve + 调试器）",
        "category": "RSL",
        "icon": "$(zap)"
      }
    ],
    "keybindings": [
      { "command": "rsl.formEditor", "key": "f6", "when": "editorTextFocus || !editorTextFocus" },
      { "command": "rsl.debug", "key": "f7", "when": "editorTextFocus || !editorTextFocus" }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "rsl.formEditor",
          "when": "resourceFilename =~ /\\.rsl\\.json$/",
          "group": "navigation@9"
        },
        {
          "command": "rsl.debug",
          "when": "resourceFilename =~ /\\.rsl\\.json$/",
          "group": "navigation@8"
        }
      ]
    },
    "configuration": {
      "title": "RSL",
      "properties": {
        "rsl.lspPath": {
          "type": "string",
          "default": "rsl-lsp",
          "description": "rsl-lsp 可执行文件路径（默认取 PATH；也可指向 target/debug/rsl-lsp.exe）"
        },
        "rsl.servePath": {
          "type": "string",
          "default": "rsl",
          "description": "rsl CLI 可执行文件路径（调试器 spawn rsl serve 用；默认取工作区 target/debug 回退 PATH）"
        },
        "rsl.webDebugRoot": {
          "type": "string",
          "default": "",
          "description": "web 调试前端目录（editors/web-debug）；留空用扩展内置"
        }
      }
    }
  },
  "scripts": {
    "sync-schema": "node -e \"require('fs').copyFileSync('../../schema/rsl.schema.json','schema/rsl.schema.json')\"",
    "test": "node test/protocol-smoke.js && node test/form-model-test.js && node test/serve-integration-test.js"
  },
  "devDependencies": {}
}
