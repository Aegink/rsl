{
  "rsl": "2.0",
  "id": "form-skel.example.com",
  "name": "表单骨架站（生成物）",
  "type": "novel",
  "baseUrl": "https://form-skel.example.com",
  "requires": {
    "features": [],
    "crypto": []
  },
  "stages": {
    "search": {
      "request": {
        "url": "https://form-skel.example.com/search",
        "params": {
          "q": "var:kw"
        }
      },
      "out": {
        "list": "css:ul.list li",
        "map": {
          "name": {
            "$": "css:a.title",
            "transform": [
              {
                "trim": true
              }
            ]
          },
          "url": {
            "$": "css:a.title",
            "attr": "href",
            "transform": [
              {
                "absolute": true
              }
            ]
          }
        },
        "emptyOk": true
      }
    },
    "detail": {
      "request": {
        "url": "var:book.url"
      },
      "out": {
        "name": "css:h1",
        "tocUrl": {
          "$": "css:a.read",
          "attr": "href",
          "optional": true
        }
      }
    },
    "toc": {
      "request": {
        "url": "var:book.tocUrl"
      },
      "out": {
        "list": "css:#list li",
        "map": {
          "title": {
            "$": "css:a",
            "transform": [
              {
                "trim": true
              }
            ]
          },
          "url": {
            "$": "css:a",
            "attr": "href",
            "transform": [
              {
                "absolute": true
              }
            ]
          }
        }
      }
    },
    "content": {
      "request": {
        "url": "var:chapter.url"
      },
      "out": {
        "content": {
          "$": "css:div#content",
          "paragraphs": {
            "split": "br"
          }
        }
      }
    }
  }
}
