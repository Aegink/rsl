{"rsl": "2.0", "id": "app.example.com", "name": "引力圈【只能搜索作者】", "type": "novel", "baseUrl": "https://example.com", "stages": {"search": {"request": {"url": "https://example.com/common/searchNickDomainName,{\n\t'method':'POST',\n\t'body':'{\"search\":\"${var:kw}\",\"searchType\":\"creator\",\"skip\":0,\"limit\":500}'\n\t}", "params": {"q": "var:kw"}}, "out": {"emptyOk": true, "list": "json:$.data.result[*]", "verify": {"contains": "++data:getPersonalInfo;base64,ZG9tYWluTmFtZT1ndWExMjM0NTY=,{\"type\":\"\"}"}, "map": {"name": "json:$.nickName", "intro": "json:$.creatingDes", "cover": "json:$.avatar"}}, "paginate": null}, "explore": {"out": {"emptyOk": true, "map": {"author": "json:$.creatorName", "cover": "json:$.picture"}}, "groups": [{"title": "标签", "url": "https://example.com/common/getPostsByHashTag?skip={{(page-1)*10}}"}, {"title": "21点牌", "url": "data:getPersonalInfo;base64,{{java.base64Encode(\"domainName=21dianpai"}, {"title": "Alphamie", "url": "data:getPersonalInfo;base64,{{java.base64Encode(\"domainName=y1250082324"}]}, "detail": {"out": {"name": "json:$.data.collection.name", "author": "json:$.data.collection.nickName", "cover": "json:$.data.collection.picture"}}, "toc": {"request": {"url": "var:book.tocUrl"}, "out": {"list": "json:$.[*]", "map": {"title": "json:$.name||$.title", "isVip": "json:$.locked"}}}, "content": {"request": {"url": "var:chapter.url"}, "out": {"transform": [{"replace": [["##Powered by Froala Editor", ""]]}]}}}, "http": {"cookies": "session"}, "match": {"detail": "re:.*/getCollectionDetail.*collectionId=.*"}, "meta": {"comment": "需登录\n如果文章有更新，要先更新目录，在刷新正文\n\n标签::https://example.com/common/getPostsByHashTag?skip={{(page-1)*10}}&limit=10&hashTag=标签名&_t=={{Date.now()}}"}, "x-legado": {"bookSourceUrl": "https://example.com/feed", "customOrder": 10, "respondTime": 180000}}